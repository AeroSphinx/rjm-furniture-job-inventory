# Copy this file to .env.local and fill in the values for your own Supabase project.
# Never paste a real secret key into this file — it is committed to git.

# Project Settings -> API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Project Settings -> API -> Publishable key (new key format; NOT the legacy anon key)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxx

# Project Settings -> API -> Secret key (new key format; NOT the legacy service_role key)
# Server-only. Leave blank in .env.local until you paste your own. Never commit a real value.
SUPABASE_SECRET_KEY=

# Shows the collapsible "Demo accounts" panel on the Login screen when "true".
NEXT_PUBLIC_DEMO_MODE=true

# scripts/seed.ts only — demo-account passwords. Pick your own values; never
# commit real ones. Not read by the application itself.
SEED_OWNER_PASSWORD=
SEED_ADMIN_PASSWORD=
SEED_WORKER_PASSWORD=
